{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "openagent",
  "instructions": ["AGENTS.md"],
  "watcher": {
    "ignore": [
      ".git/**",
      ".tmp/**",
      ".opencode/node_modules/**",
      "_db-data/**",
      "_wordpress/**",
      "build/**",
      "azwp-mailer/update-checker/**",
      "*.zip"
    ]
  },
  "share": "disabled",
  "autoupdate": "notify",
  "permission": {
    "read": {
      "*": "allow",
      ".env*": "deny",
      "**/.env*": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/*.secret": "deny",
      ".env.example": "allow"
    },
    "edit": {
      "*": "ask",
      ".env*": "deny",
      "**/.env*": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/*.secret": "deny",
      ".git/**": "deny",
      "**/.git/**": "deny",
      ".env.example": "ask"
    },
    "bash": {
      "*": "ask",
      "rm *": "deny",
      "rmdir *": "deny",
      "sudo *": "deny",
      "git clean *": "deny",
      "git reset --hard*": "deny",
      "git checkout -- *": "deny",
      "git restore *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny"
    },
    "external_directory": "ask"
  }
}
